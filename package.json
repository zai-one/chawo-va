{
  "name": "chawo-va-workspace",
  "private": true,
  "description": "Chawo Voice Assistant monorepo: the Electron app, the CLI and shared packages.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @chawo/desktop dev",
    "build": "pnpm --filter @chawo/desktop build",
    "start": "pnpm --filter @chawo/desktop start",
    "cli": "node apps/desktop/out/main/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "e2e": "pnpm --filter @chawo/desktop e2e",
    "dist:win": "pnpm --filter @chawo/desktop dist:win",
    "dist:dir": "pnpm --filter @chawo/desktop dist:dir"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
