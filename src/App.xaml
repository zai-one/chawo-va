<Application x:Class="ChawoVA.App.ChawoApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Dark">
    <Application.Resources>
        <!--
          Chawo dark UI only (no light theme, no toggle).
          Brand tokens from https://chawo.ai CSS (:root) and /icon.svg.
          Surfaces: almost-black / surface / muted card. Ink: peach-cream.
          Accent: coral. Secondary accent: sunset (sparingly).
          DIN Pro is not bundled; Arial then Segoe UI.
          Every Brush property must use a SolidColorBrush key — never a Color key.
        -->
        <Color x:Key="ChawoPeachCream">#FFF3E2</Color>
        <Color x:Key="ChawoWarmSand">#FEE9CE</Color>
        <Color x:Key="ChawoSurfaceCream">#F7E7D0</Color>
        <Color x:Key="ChawoAlmostBlack">#0A0A0A</Color>
        <Color x:Key="ChawoSurface">#171717</Color>
        <Color x:Key="ChawoSurfaceMuted">#222222</Color>
        <Color x:Key="ChawoDarkGrey">#4E4E4E</Color>
        <Color x:Key="ChawoCoral">#EF5143</Color>
        <Color x:Key="ChawoCoralInk">#C9382B</Color>
        <Color x:Key="ChawoSunset">#FFB261</Color>
        <Color x:Key="ChawoSunsetInk">#B56A12</Color>

        <SolidColorBrush x:Key="ChawoBgBrush" Color="{StaticResource ChawoAlmostBlack}"/>
        <SolidColorBrush x:Key="ChawoSurfaceBrush" Color="{StaticResource ChawoSurface}"/>
        <SolidColorBrush x:Key="ChawoCardBrush" Color="{StaticResource ChawoSurfaceMuted}"/>
        <SolidColorBrush x:Key="ChawoInkBrush" Color="{StaticResource ChawoPeachCream}"/>
        <SolidColorBrush x:Key="ChawoMutedBrush" Color="#A6FEE9CE"/>
        <SolidColorBrush x:Key="ChawoAccentBrush" Color="{StaticResource ChawoCoralInk}"/>
        <SolidColorBrush x:Key="ChawoAccentFillBrush" Color="{StaticResource ChawoCoral}"/>
        <SolidColorBrush x:Key="ChawoWarnBrush" Color="{StaticResource ChawoSunset}"/>
        <SolidColorBrush x:Key="ChawoBorderBrush" Color="#3DFEE9CE"/>
        <!-- Kept for any leftover callers; same as the dark surface/ink pair. -->
        <SolidColorBrush x:Key="ChawoDarkBgBrush" Color="{StaticResource ChawoSurface}"/>
        <SolidColorBrush x:Key="ChawoDarkInkBrush" Color="{StaticResource ChawoWarmSand}"/>

        <FontFamily x:Key="ChawoFont">Arial, Segoe UI Variable, Segoe UI</FontFamily>
        <CornerRadius x:Key="ChawoCardRadius">12</CornerRadius>
        <CornerRadius x:Key="ChawoChipRadius">9</CornerRadius>
        <CornerRadius x:Key="ChawoMediaRadius">16</CornerRadius>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource ChawoBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChawoPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ChawoAccentFillBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource ChawoInkBrush}"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource ChawoInkBrush}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoBorderBrush}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoCardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoSurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoAccentFillBrush}"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Application.Resources>
</Application>
