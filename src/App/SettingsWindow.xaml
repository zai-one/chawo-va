<Window x:Class="ChawoVA.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:ChawoVA.App"
        Width="920" Height="560" MinWidth="820" MinHeight="420"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource ChawoBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left nav strip: dark surface strip -->
        <Border Grid.Column="0" Background="{StaticResource ChawoSurfaceBrush}" Margin="0"/>
        <ListBox x:Name="Nav" Grid.Column="0" Margin="10,14,6,14"
                 SelectionChanged="Nav_Changed">
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavDictation" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavFile" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavSpeech" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE82D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavDictionary" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE719;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavSales" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA80;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavBrain" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NavNetwork" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16,18,28,20">

                <StackPanel x:Name="DictationPage">
                    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Intro" Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModeLabel" Margin="0,14,0,4" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ModeBox" MinWidth="240" HorizontalAlignment="Left" SelectionChanged="Mode_Changed"/>
                    <TextBlock x:Name="ModeHint" Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"/>
                    <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="{StaticResource ChawoCardRadius}"
                            Background="{StaticResource ChawoCardBrush}" BorderThickness="1" BorderBrush="{StaticResource ChawoBorderBrush}">
                        <DockPanel>
                            <Button x:Name="StopButton" DockPanel.Dock="Right" MinWidth="96" Padding="14,5" Margin="12,0,0,0"
                                    Click="Stop_Click" IsEnabled="False" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PhaseLine" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14"/>
                        </DockPanel>
                    </Border>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="HotkeyLabel" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="HotkeyBox" MinWidth="240" HorizontalAlignment="Left" SelectionChanged="Hotkey_Changed"/>
                        <TextBlock x:Name="InsertLabel" Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="InsertBox" Margin="0,10,0,0" MinWidth="240" HorizontalAlignment="Left" SelectionChanged="Insert_Changed"/>
                        <TextBlock x:Name="LanguageLabel" Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LanguageBox" Margin="0,10,0,0" MinWidth="240" HorizontalAlignment="Left" SelectionChanged="Language_Changed"/>
                    </Grid>
                    <TextBlock x:Name="MicLabel" Margin="0,14,0,4" FontWeight="SemiBold"/>
                    <ComboBox x:Name="MicBox" MinWidth="360" HorizontalAlignment="Left" SelectionChanged="Mic_Changed"/>
                    <TextBlock x:Name="MicHint" Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="OverlayBox" VerticalAlignment="Center" Click="Overlay_Click"/>
                        <Button x:Name="UnpinButton" Margin="12,0,0,0" Padding="10,2" FontSize="12" Click="Unpin_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="CopyClipBox" Margin="0,12,0,0" Click="CopyClip_Click"/>
                    <TextBlock x:Name="CopyClipHint" Margin="22,2,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    <CheckBox x:Name="RestoreClipBox" Margin="22,4,0,0" Click="RestoreClip_Click"/>
                    <CheckBox x:Name="AutostartBox" Margin="0,10,0,0" Click="Autostart_Click"/>
                    <TextBlock x:Name="TrayHint" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"/>
                    <Button x:Name="CheckUpdatesButton" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="12,4" Click="CheckUpdates_Click"/>
                </StackPanel>

                <StackPanel x:Name="FilePage" Visibility="Collapsed">
                    <TextBlock x:Name="FileHeading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FileNote" Margin="0,4,0,12" Opacity="0.75" TextWrapping="Wrap"/>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button x:Name="FilePickButton" Padding="12,4" Click="FilePick_Click"/>
                            <Button x:Name="FileFolderButton" Margin="6,0,0,0" Padding="12,4" Click="FileFolder_Click"/>
                        </StackPanel>
                        <TextBox x:Name="FilePathBox" Padding="7,5" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="FileRunButton" Padding="12,4" Click="FileRun_Click" FontWeight="SemiBold"/>
                        <Button x:Name="FileStopButton" Margin="8,0,0,0" Padding="12,4" Click="FileStop_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="FileStatus" Margin="0,6,0,0" Opacity="0.85" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FileFfmpegStatus" Margin="0,14,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                    <Button x:Name="FileFfmpegButton" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" Click="FileFfmpeg_Click"/>
                </StackPanel>

                <StackPanel x:Name="SpeechPage" Visibility="Collapsed">
                    <TextBlock x:Name="SpeechHeading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SpeechIntro" Margin="0,4,0,8" Opacity="0.75" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModelLabel" FontWeight="SemiBold"/>
                    <StackPanel x:Name="SpeechModelRows"/>
                    <TextBlock x:Name="ModelNote" Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DeviceLabel" Margin="0,14,0,4" FontWeight="SemiBold"/>
                    <ComboBox x:Name="DeviceBox" MinWidth="360" HorizontalAlignment="Left" SelectionChanged="SpeechDevice_Changed"/>
                    <StackPanel x:Name="WarmupPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="WarmupLabel" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WarmupHint" Margin="0,4,0,8" Opacity="0.7" TextWrapping="Wrap"/>
                        <Button x:Name="WarmupButton" HorizontalAlignment="Left" Padding="12,4" Click="Warmup_Click"/>
                        <TextBlock x:Name="WarmupStatus" Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="ThreadsPanel">
                        <TextBlock x:Name="ThreadsLabel" Margin="0,12,0,4" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ThreadsBox" MinWidth="360" HorizontalAlignment="Left" SelectionChanged="CpuThreads_Changed"/>
                        <TextBlock x:Name="ThreadsHint" Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="SpeechStatus" Margin="0,10,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="DictionaryPage" Visibility="Collapsed">
                    <TextBlock x:Name="DictionaryHeading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DictionaryIntro" Margin="0,4,0,8" Opacity="0.75" TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeardHeader" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WrittenHeader" Grid.Column="1" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </Grid>
                    <StackPanel x:Name="DictionaryRows"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AddDictionaryButton" HorizontalAlignment="Left" Padding="12,4" Click="AddDictionary_Click"/>
                        <Button x:Name="SuggestDictionaryButton" Margin="8,0,0,0" Padding="12,4" Click="SuggestDictionary_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SuggestDictionaryHint" Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap"/>
                    <StackPanel x:Name="SuggestDictionaryRows" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel x:Name="SalesPage" Visibility="Collapsed">
                    <TextBlock x:Name="SalesHeading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SalesIntro" Margin="0,4,0,8" Opacity="0.75" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CallHeading" Margin="0,4,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CallIntro" Margin="0,0,0,8" Opacity="0.75" TextWrapping="Wrap"/>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CallExtensionHeader" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CallNumberHeader" Grid.Column="1" Margin="8,0,0,0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CallManagerHeader" Grid.Column="2" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CallExtensionBox" Padding="7,5"/>
                        <TextBox x:Name="CallNumberBox" Grid.Column="1" Margin="8,0,0,0" Padding="7,5"/>
                        <TextBox x:Name="CallManagerBox" Grid.Column="2" Margin="8,0,0,0" Padding="7,5"/>
                    </Grid>
                    <Button x:Name="ShowCallButton" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" Click="ShowCall_Click"/>
                    <TextBlock x:Name="CallStatus" Margin="0,6,0,12" Opacity="0.75" TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CodeHeader" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NameHeader" Grid.Column="1" Margin="8,0,0,0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LineHeader" Grid.Column="2" Margin="8,0,0,0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SimilarHeader" Grid.Column="3" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </Grid>
                    <StackPanel x:Name="SalesRows"/>
                    <Button x:Name="AddSalesButton" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4" Click="AddSales_Click"/>
                    <TextBlock x:Name="RagHeading" Margin="0,18,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RagIntro" Margin="0,0,0,8" Opacity="0.75" TextWrapping="Wrap"/>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="RagClearButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,4" Click="RagClear_Click"/>
                        <Button x:Name="RagPickButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,4" Click="RagPick_Click"/>
                        <TextBox x:Name="RagFolderBox" Padding="7,5" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="RagStatus" Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="BrainPage" Visibility="Collapsed">
                    <TextBlock x:Name="CleanupHeading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CleanupHint" Margin="0,4,0,12" Opacity="0.75" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BrainLabel" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="BrainBox" MinWidth="280" HorizontalAlignment="Left" SelectionChanged="Brain_Changed"/>
                    </Grid>
                    <TextBlock x:Name="BrainStatus" Margin="0,6,0,0" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BrainModelLabel" Margin="0,14,0,4" FontWeight="SemiBold"/>
                    <StackPanel x:Name="BrainModelRows"/>
                    <TextBlock x:Name="BrainDeviceLabel" Margin="0,12,0,4" FontWeight="SemiBold"/>
                    <ComboBox x:Name="BrainDeviceBox" MinWidth="360" HorizontalAlignment="Left" SelectionChanged="BrainDevice_Changed"/>
                    <TextBlock x:Name="BrainDeviceHint" Margin="0,4,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BrainUrlLabel" Margin="0,10,0,4"/>
                    <TextBox x:Name="BrainUrlBox" Padding="7,5" LostFocus="BrainUrl_LostFocus"/>
                    <TextBlock x:Name="BrainFileStatus" Margin="0,6,0,0" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                    <app:BrainServerPanel x:Name="ServerPanel" Margin="0,12,0,0"/>
                    <TextBlock x:Name="EveryTakeLabel" Margin="0,16,0,4" FontWeight="SemiBold"/>
                    <ComboBox x:Name="EveryTakeBox" MinWidth="360" HorizontalAlignment="Left" SelectionChanged="EveryTake_Changed"/>
                    <TextBlock x:Name="EveryTakeHint" Margin="0,4,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    <TextBlock x:Name="InstructionLabel" Margin="0,12,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="InstructionBox" Padding="7" Height="80" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="Instruction_LostFocus"/>
                    <TextBlock x:Name="InstructionHint" Margin="0,4,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    <CheckBox x:Name="SelectionBox" Margin="0,14,0,0" Click="Selection_Click"/>
                    <TextBlock x:Name="SelectionHint" Margin="22,2,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="NetworkPage" Visibility="Collapsed">
                    <TextBlock x:Name="NetworkHeading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NetworkIntro" Margin="0,4,0,10" Opacity="0.75" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RoleLabel" FontWeight="SemiBold"/>
                    <ComboBox x:Name="RoleBox" MinWidth="360" HorizontalAlignment="Left" Margin="0,4,0,0" SelectionChanged="Role_Changed"/>
                    <StackPanel x:Name="HostPanel" Margin="0,14,0,0">
                        <TextBlock x:Name="HostNote" TextWrapping="Wrap"/>
                        <TextBlock x:Name="HermesHeading" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock x:Name="HermesListenStatus" Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                        <Button x:Name="LanButton" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4" Click="Lan_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="ClientPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ClientNote" TextWrapping="Wrap"/>
                        <TextBlock x:Name="RemoteHostLabel" Margin="0,12,0,4" FontWeight="SemiBold"/>
                        <TextBox x:Name="RemoteHostBox" Padding="7,5" LostFocus="Remote_LostFocus"/>
                        <TextBlock x:Name="RemotePortLabel" Margin="0,10,0,4" FontWeight="SemiBold"/>
                        <TextBox x:Name="RemotePortBox" Padding="7,5" Width="120" HorizontalAlignment="Left" LostFocus="Remote_LostFocus"/>
                        <Button x:Name="CheckHostButton" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,4" Click="CheckHost_Click"/>
                        <TextBlock x:Name="HostCheckStatus" Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
