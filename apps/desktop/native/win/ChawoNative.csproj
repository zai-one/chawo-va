<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows helper for the Electron app: global hold key (low-level keyboard hook), inserting text
       into the focused app (SendInput / clipboard + Ctrl+V), copying a selection, the foreground app.
       .NET Framework 4.8 ships with Windows 10/11, so the exe is a few KB and needs no runtime.
       Builds on any OS with the .NET SDK: pnpm build:native (in apps/desktop). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ChawoNative</AssemblyName>
    <RootNamespace>ChawoNative</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Chawo Voice Assistant</Product>
    <Description>Chawo Voice Assistant native helper (hold key, text insertion)</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- test/ holds the smoke-test target window, a separate project. -->
    <Compile Remove="test/**" />
    <None Remove="test/**" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- UI Automation (SelectionReader): part of .NET Framework on every Windows 10/11. -->
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
</Project>
