{
  "name": "@chawo/desktop",
  "productName": "Chawo Voice Assistant",
  "version": "2.0.0",
  "description": "Chawo Voice Assistant: local dictation and file transcription (Electron).",
  "license": "MIT",
  "author": "Chawo",
  "repository": {
    "type": "git",
    "url": "https://github.com/zai-one/chawo-va.git"
  },
  "private": true,
  "main": "out/main/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "build:native": "dotnet build native/win/ChawoNative.csproj -c Release -o native/win/bin/out",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "package:win": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never",
    "e2e": "electron-vite build && node scripts/e2e-smoke.cjs",
    "e2e:pw": "electron-vite build && playwright test",
    "check:fuses": "node scripts/check-fuses.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "onnxruntime-node": "^1.30.0",
    "opus-decoder": "^0.7.12",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@chawo/cli": "workspace:*",
    "@chawo/core": "workspace:*",
    "@chawo/engine": "workspace:*",
    "@chawo/ipc": "workspace:*",
    "@chawo/ui": "workspace:*",
    "@electron/fuses": "2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "one.zai.chawo-va",
    "productName": "Chawo Voice Assistant",
    "executableName": "ChawoVoiceAssistant",
    "copyright": "Chawo",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "out/**/*",
      "resources/iconset/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!**/*.{onnx,ort,gguf,safetensors,pt,pth,ckpt}"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sherpa-onnx-*/**",
      "node_modules/@napi-rs/keyring*/**"
    ],
    "extraResources": [
      {
        "from": "native/win/bin/out",
        "to": "native",
        "filter": [
          "ChawoNative.exe",
          "ChawoNative.exe.config"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/app.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "artifactName": "ChawoVoiceAssistant-${version}-win-x64.${ext}",
      "extraFiles": [
        {
          "from": "packaging/win/chawo-va.cmd",
          "to": "chawo-va.cmd"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ChawoVoiceAssistant-${version}-Setup.${ext}",
      "shortcutName": "Chawo Voice Assistant",
      "deleteAppDataOnUninstall": false
    }
  }
}
