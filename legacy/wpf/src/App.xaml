<Application x:Class="ChawoVA.App.ChawoApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Dark">
    <Application.Resources>
        <!--
          Chawo dark UI only (no light theme, no toggle).
          Brand tokens from https://chawo.ai CSS (:root) and /icon.svg.
          Surfaces: almost-black / surface / muted card. Ink: peach-cream.
          Accent: coral. Secondary accent: sunset (sparingly).
          DIN Pro is not bundled; Arial then Segoe UI.
          Every Brush property must use a SolidColorBrush key — never a Color key.
          ComboBox needs a full ControlTemplate on Windows: the Aero/Fluent closed
          chrome ignores Background, leaving a light gradient with unreadable ink.
        -->
        <Color x:Key="ChawoPeachCream">#FFF3E2</Color>
        <Color x:Key="ChawoWarmSand">#FEE9CE</Color>
        <Color x:Key="ChawoSurfaceCream">#F7E7D0</Color>
        <Color x:Key="ChawoAlmostBlack">#0A0A0A</Color>
        <Color x:Key="ChawoSurface">#171717</Color>
        <Color x:Key="ChawoSurfaceMuted">#222222</Color>
        <Color x:Key="ChawoComboChrome">#2A2A2A</Color>
        <Color x:Key="ChawoComboHover">#333333</Color>
        <Color x:Key="ChawoComboSelected">#3A221F</Color>
        <Color x:Key="ChawoDarkGrey">#4E4E4E</Color>
        <Color x:Key="ChawoCoral">#EF5143</Color>
        <Color x:Key="ChawoCoralInk">#C9382B</Color>
        <Color x:Key="ChawoSunset">#FFB261</Color>
        <Color x:Key="ChawoSunsetInk">#B56A12</Color>

        <SolidColorBrush x:Key="ChawoBgBrush" Color="{StaticResource ChawoAlmostBlack}"/>
        <SolidColorBrush x:Key="ChawoSurfaceBrush" Color="{StaticResource ChawoSurface}"/>
        <SolidColorBrush x:Key="ChawoCardBrush" Color="{StaticResource ChawoSurfaceMuted}"/>
        <SolidColorBrush x:Key="ChawoInkBrush" Color="{StaticResource ChawoPeachCream}"/>
        <SolidColorBrush x:Key="ChawoMutedBrush" Color="#A6FEE9CE"/>
        <SolidColorBrush x:Key="ChawoAccentBrush" Color="{StaticResource ChawoCoralInk}"/>
        <SolidColorBrush x:Key="ChawoAccentFillBrush" Color="{StaticResource ChawoCoral}"/>
        <SolidColorBrush x:Key="ChawoWarnBrush" Color="{StaticResource ChawoSunset}"/>
        <SolidColorBrush x:Key="ChawoBorderBrush" Color="#3DFEE9CE"/>
        <SolidColorBrush x:Key="ChawoComboBorderBrush" Color="{StaticResource ChawoComboChrome}"/>
        <SolidColorBrush x:Key="ChawoComboHoverBrush" Color="{StaticResource ChawoComboHover}"/>
        <SolidColorBrush x:Key="ChawoComboSelectedBrush" Color="{StaticResource ChawoComboSelected}"/>
        <SolidColorBrush x:Key="ChawoScrollTrackBrush" Color="{StaticResource ChawoSurface}"/>
        <SolidColorBrush x:Key="ChawoScrollThumbBrush" Color="{StaticResource ChawoDarkGrey}"/>
        <SolidColorBrush x:Key="ChawoScrollThumbHoverBrush" Color="#6A6A6A"/>
        <SolidColorBrush x:Key="ChawoSelectionBrush" Color="#66EF5143"/>
        <SolidColorBrush x:Key="ChawoDisabledInkBrush" Color="#66FEE9CE"/>
        <!-- Kept for any leftover callers; same as the dark surface/ink pair. -->
        <SolidColorBrush x:Key="ChawoDarkBgBrush" Color="{StaticResource ChawoSurface}"/>
        <SolidColorBrush x:Key="ChawoDarkInkBrush" Color="{StaticResource ChawoWarmSand}"/>

        <FontFamily x:Key="ChawoFont">Arial, Segoe UI Variable, Segoe UI</FontFamily>
        <CornerRadius x:Key="ChawoCardRadius">12</CornerRadius>
        <CornerRadius x:Key="ChawoChipRadius">9</CornerRadius>
        <CornerRadius x:Key="ChawoControlRadius">8</CornerRadius>
        <CornerRadius x:Key="ChawoMediaRadius">16</CornerRadius>

        <!-- ========== ScrollBar (dark, used by ComboBox popup + ScrollViewer) ========== -->
        <Style x:Key="ChawoScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{StaticResource ChawoScrollThumbBrush}" CornerRadius="4" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoScrollThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoAccentFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChawoScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChawoScrollBarLineButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="0" Width="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ChawoVerticalScrollBar" TargetType="ScrollBar">
            <Grid Background="{StaticResource ChawoScrollTrackBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>
                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ChawoScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ChawoScrollBarThumb}" Margin="2,0"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ChawoScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ChawoHorizontalScrollBar" TargetType="ScrollBar">
            <Grid Background="{StaticResource ChawoScrollTrackBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>
                <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ChawoScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ChawoScrollBarThumb}" Margin="0,2"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ChawoScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="{StaticResource ChawoScrollTrackBrush}"/>
            <Setter Property="Template" Value="{StaticResource ChawoVerticalScrollBar}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource ChawoHorizontalScrollBar}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
        </Style>

        <!-- ========== Window ========== -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource ChawoBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
        </Style>

        <!-- ========== Button (readable dark secondary by default) ========== -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoComboBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoComboHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChawoBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoSurfaceBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChawoAccentFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChawoAccentFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ChawoDisabledInkBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChawoPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ChawoAccentFillBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ========== TextBox / PasswordBox ========== -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoComboBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource ChawoSelectionBrush}"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChawoBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChawoAccentFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ChawoDisabledInkBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoComboBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource ChawoSelectionBrush}"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChawoBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChawoAccentFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ChawoDisabledInkBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== ComboBox (full custom template — Aero ignores Background when closed) ==========
          1.17.2 bug: ThemeMode="Dark" merges the Fluent dictionary into Application.Resources, and its
          implicit ToggleButton style (DefaultToggleButtonStyle) sets HorizontalAlignment=Left and
          VerticalAlignment=Center. OverridesDefaultStyle on the ComboBox does not reach the ToggleButton
          inside its template, so the toggle still took that implicit style: it shrank to its desired size
          (28 px arrow column x 6 px Path) at the left of the field while the text sat on top, outside it.
          Fix: the toggle gets its own keyed style (an explicit Style replaces the implicit one) with
          OverridesDefaultStyle=True and Stretch/Stretch, and the template sets Stretch locally as well.
          tools/check-xaml-combobox.py guards this on Linux.
        -->
        <ControlTemplate x:Key="ChawoComboToggle" TargetType="ToggleButton">
            <Grid Background="Transparent"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Chrome"
                        Grid.ColumnSpan="2"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True"/>
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      Data="M 0,0 L 5,5 L 10,0 Z"
                      Fill="{StaticResource ChawoAccentFillBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stretch="None"
                      SnapsToDevicePixels="True"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChawoComboHoverBrush}"/>
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChawoBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ChawoAccentFillBrush}"/>
                    <Setter TargetName="Arrow" Property="Data" Value="M 0,5 L 5,0 L 10,5 Z"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource ChawoDisabledInkBrush}"/>
                    <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ChawoComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template" Value="{StaticResource ChawoComboToggle}"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoComboHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoComboHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoComboSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoComboSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChawoAccentFillBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ChawoDisabledInkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoComboBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ChawoComboToggleStyle}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="10,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Focusable="True"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{StaticResource ChawoInkBrush}"
                                     SelectionBrush="{StaticResource ChawoSelectionBrush}"
                                     BorderThickness="0"
                                     Margin="8,2,32,2"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Padding="2,0"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      MinWidth="{Binding ActualWidth, ElementName=Root}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource ChawoCardBrush}"
                                            BorderBrush="{StaticResource ChawoComboBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.55" Color="#000000" Direction="270"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ChawoDisabledInkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource ChawoAccentFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== CheckBox ========== -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoComboBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="18" Height="18"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="Check"
                                      Data="M 2,9 L 7,14 L 16,3"
                                      Stroke="{StaticResource ChawoInkBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Margin="1"
                                      Visibility="Collapsed"
                                      Stretch="Uniform"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource ChawoAccentFillBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ChawoAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ChawoBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ChawoAccentFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ChawoDisabledInkBrush}"/>
                                <Setter TargetName="Box" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== TextBlock / ListBox ========== -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="{StaticResource ChawoFont}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoCardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChawoComboHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ChawoDisabledInkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== DataGrid (if any catalog/dictionary tables appear later) ========== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource ChawoSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoComboBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource ChawoSurfaceBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ChawoComboBorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource ChawoComboBorderBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ChawoSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoComboBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ChawoComboSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ChawoComboHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ChawoComboSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource ChawoInkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========== Slider (defensive; none in UI today) ========== -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource ChawoAccentFillBrush}"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChawoComboBorderBrush}"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource ChawoAccentFillBrush}"/>
            <Setter Property="Background" Value="{StaticResource ChawoCardBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Application.Resources>
</Application>
