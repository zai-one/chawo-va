<Window x:Class="ChawoVA.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="Manual" Width="120" Height="58"
        FontFamily="{StaticResource ChawoFont}">
    <Border x:Name="Pill" CornerRadius="{StaticResource ChawoMediaRadius}" Height="30" Width="92" Margin="14"
            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="SizeAll"
            Background="#F2171717" BorderBrush="#42FEE9CE" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.20" Color="#0A0A0A"/>
        </Border.Effect>
        <StackPanel>
            <Grid Height="30">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="Caption" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center"
                               FontSize="12.5" FontFamily="{StaticResource ChawoFont}"/>
                    <StackPanel x:Name="Bars" Orientation="Horizontal" Height="22" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                           Foreground="#E6FEE9CE" FontSize="12.5" FontFamily="{StaticResource ChawoFont}"/>
            </Grid>
            <TextBlock x:Name="Live" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="380"
                       Margin="0,2,0,0" FontSize="14.5" FontFamily="{StaticResource ChawoFont}"
                       Foreground="#E6FEE9CE"/>
        </StackPanel>
    </Border>
</Window>
